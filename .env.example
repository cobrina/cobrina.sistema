MONGO_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER/cobrina_rdc
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_SEGURO
FRONTEND_URL=https://cobrina-rdc.netlify.app
NODE_ENV=production
PORT=5000

# Fuente única: solo pagos de Cobrina aplican saldo
PAGOS_FUENTE_UNICA_ACTIVA=true

# Vacío = sesión sin fecha fija. Ejemplo con vencimiento: 7d
JWT_EXPIRES_IN=
JWT_REFRESH_WINDOW_SECONDS=86400
